# Provider Keys (OmniRoute Unified Gateway)
LLM_BASE_URL=http://omniroute:8000/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o

# External Model Provider Keys for OmniRoute
OPENROUTER_API_KEY=sk-or-v1-your-key-here
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Database Settings
POSTGRES_PASSWORD=change-me-in-production

# Security & Admin Setup
# Note: First user to register automatically becomes Admin with $10/mo default budget
JWT_SECRET=change-me-in-production-use-random-32-chars
