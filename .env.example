# Connect directly to any OpenAI-compatible provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=gpt-4o
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=replace-with-embedding-provider-key
# URL-encode special characters in the password when used in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional: leave empty to generate a persistent random SearXNG secret.
SEARXNG_SECRET=
# First registered user becomes administrator.

# Limits for each user's shared computer (new containers only).
SANDBOX_DATA_PACKAGES=false
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_IDLE_MINUTES=10
# Used by docker-compose.local.yml only; configure the separate web deployments
# with their public backend URLs as Docker build arguments.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
NEXT_PUBLIC_DESKTOP_BASE_URL=http://localhost
